# stage 1: build
ARG GO_IMAGE_TAG=1.26-alpine
FROM golang:${GO_IMAGE_TAG} AS builder

# Source is provisioned by scripts/prepare-staging-build-context.sh
# into infra/_build_deps/nodeagent/, which is in the build context.
COPY _build_deps/nodeagent/ /src/

RUN if [ ! -f /src/go.mod ]; then \
      echo "FATAL: No go.mod found in /src/." >&2; \
      echo "Run scripts/prepare-staging-build-context.sh before docker compose build." >&2; \
      exit 1; \
    fi

WORKDIR /src
RUN apk add --no-cache bash python3 openssl
RUN go mod download
ARG NODEAGENT_USE_GARBLE=0
ARG NODEAGENT_VERSION=dev
ENV VERSION="${NODEAGENT_VERSION}" \
    NODEAGENT_USE_GARBLE="${NODEAGENT_USE_GARBLE}" \
    OUT_DIR=/out
RUN chmod +x scripts/build-protected-release.sh \
    && bash scripts/build-protected-release.sh \
    && cp "/out/nodeagent_${NODEAGENT_VERSION}_linux_amd64" /out/nodeagent

# stage 2: runtime
FROM alpine:3.20
ARG NODEAGENT_VERSION=dev
RUN apk add --no-cache ca-certificates curl python3 tar wget
WORKDIR /app
COPY --from=builder /out/nodeagent /usr/local/bin/livemask-nodeagent
COPY _build_deps/nodeagent/scripts/install-singbox.sh /usr/local/bin/install-singbox.sh
COPY _build_deps/nodeagent/docker/entrypoint.sh /usr/local/bin/livemask-nodeagent-entrypoint
RUN chmod +x /usr/local/bin/livemask-nodeagent-entrypoint /usr/local/bin/install-singbox.sh \
    && sh /usr/local/bin/install-singbox.sh /usr/local/bin \
    && mkdir -p /var/lib/livemask-nodeagent /var/lib/livemask-nodeagent/sing-box /var/lib/livemask-nodeagent/geoip /var/lib/livemask-nodeagent/releases
ENV NODEAGENT_ENDPOINT_CONFIG_URL="https://gitlab.com/sammytan/livemaskvpn/-/raw/main/cfg.json" \
    NODEAGENT_API_ENDPOINTS="https://api.livemask-vpn.com https://api.vpn-mirrors.xyz https://api.vpn-mirrors.cfd" \
    NODEAGENT_JOB_ENDPOINTS="https://job.livemask-vpn.com https://job.vpn-mirrors.xyz https://job.vpn-mirrors.cfd" \
    NODEAGENT_ENDPOINT_AUTO_RESOLVE="true" \
    NODEAGENT_INSTALL_SINGBOX_ON_START="true" \
    NODEAGENT_AUTO_DETECT_PUBLIC_ENDPOINT="true" \
    NODEAGENT_API_PROBE_PATH="/api/v1/health" \
    NODEAGENT_ENDPOINT_PROBE_TIMEOUT_SEC="5" \
    NODEAGENT_REGISTRATION_ENABLED="true" \
    NODEAGENT_APP_CONNECT_ONLY="true" \
    NODEAGENT_PORT="9100" \
    LISTEN_ADDR=":9100" \
    AGENT_VERSION="${NODEAGENT_VERSION}" \
    NODEAGENT_AGENT_VERSION="${NODEAGENT_VERSION}" \
    IDENTITY_PATH="/var/lib/livemask-nodeagent/identity.json" \
    CREDENTIAL_PATH="/var/lib/livemask-nodeagent/credentials.json" \
    CONFIG_CACHE_PATH="/var/lib/livemask-nodeagent/runtime_config.json" \
    NODEAGENT_RUNTIME_CONFIG_CACHE_PATH="/var/lib/livemask-nodeagent/runtime_config.json" \
    NODEAGENT_RUNTIME_CONFIG_LKG_PATH="/var/lib/livemask-nodeagent/runtime_config.lkg.json" \
    NODEAGENT_SINGBOX_CONFIG_PATH="/var/lib/livemask-nodeagent/sing-box/config.json" \
    NODEAGENT_SINGBOX_WORK_DIR="/var/lib/livemask-nodeagent/sing-box" \
    NODEAGENT_GEOIP_CACHE_DIR="/var/lib/livemask-nodeagent/geoip" \
    NODEAGENT_RELEASE_ARTIFACT_DIR="/var/lib/livemask-nodeagent/releases" \
    SINGBOX_PROTOCOL_PROFILE="hysteria2" \
    SINGBOX_TRANSPORT="udp" \
    SINGBOX_LISTEN_HOST="0.0.0.0" \
    SINGBOX_LISTEN_PORT="8443" \
    SINGBOX_PUBLIC_ENDPOINT_PORT="8443" \
    GEOIP_ENABLED="true" \
    NODEAGENT_GEOIP_ENABLED="true" \
    LOG_UPLOAD_ENABLED="true" \
    METRICS_ENABLED="true"
VOLUME ["/var/lib/livemask-nodeagent"]
EXPOSE 9100/tcp
EXPOSE 8443/udp
ENTRYPOINT ["/usr/local/bin/livemask-nodeagent-entrypoint"]
CMD ["/usr/local/bin/livemask-nodeagent"]
