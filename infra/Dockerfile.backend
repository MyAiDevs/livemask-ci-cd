# stage 1: build
ARG GO_IMAGE_TAG=1.25-alpine
FROM golang:${GO_IMAGE_TAG} AS builder

# Source is provisioned by scripts/prepare-staging-build-context.sh
# into infra/_build_deps/backend/, which is in the build context.
COPY _build_deps/backend/ /src/

RUN if [ ! -f /src/go.mod ]; then \
      echo "FATAL: No go.mod found in /src/." >&2; \
      echo "Run scripts/prepare-staging-build-context.sh before docker compose build." >&2; \
      exit 1; \
    fi

WORKDIR /src
RUN go mod download
RUN CGO_ENABLED=0 go build -o /out/server ./main.go

# stage 2: runtime
FROM alpine:3.19

# sing-box is required by the backend GeoIP service to compile imported
# geosite-cn suffix rules (v2ray-rules-dat / Surge .txt) into .srs rule-sets.
# Pinned to match the nodeagent runtime (see livemask-nodeagent install-singbox.sh).
ARG SINGBOX_VERSION=v1.13.0

RUN apk add --no-cache ca-certificates postgresql-client wget tar \
    && set -eux \
    && arch="$(apk --print-arch)" \
    && case "$arch" in \
         x86_64) sbarch="amd64" ;; \
         aarch64) sbarch="arm64" ;; \
         *) echo "unsupported arch for sing-box: $arch" >&2; exit 1 ;; \
       esac \
    && ver="${SINGBOX_VERSION#v}" \
    && tarball="sing-box-${ver}-linux-${sbarch}-musl.tar.gz" \
    && wget -q "https://github.com/SagerNet/sing-box/releases/download/${SINGBOX_VERSION}/${tarball}" -O /tmp/sing-box.tar.gz \
    && tar -xzf /tmp/sing-box.tar.gz -C /tmp \
    && install -m 0755 "/tmp/sing-box-${ver}-linux-${sbarch}-musl/sing-box" /usr/local/bin/sing-box \
    && rm -rf /tmp/sing-box.tar.gz "/tmp/sing-box-${ver}-linux-${sbarch}-musl" \
    && sing-box version

WORKDIR /app
COPY --from=builder /out/server .
COPY --from=builder /src/data/cert ./data/cert
EXPOSE 8080
CMD ["./server"]
