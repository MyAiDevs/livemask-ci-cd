# LiveMask Mailu runtime example.
# Copy to infra/mailu/mailu.env or provide MAILU_ENV_FILE=/secure/path/mailu.env.
# Do not commit real passwords or generated secrets.

MAILU_VERSION=2024.06
MAILU_IMAGE_REGISTRY=ghcr.io/mailu
MAILU_COMPOSE_PROJECT=livemask-mailu

# Public mail identity.
DOMAIN=livemask-vpn.com
HOSTNAMES=smtp.livemask-vpn.com,imap.livemask-vpn.com
POSTMASTER=admin
SITENAME="LiveMask Mail"
WEBSITE=https://www.livemask-vpn.com

# Required secret. deploy-mailu.sh --init-env can generate this locally.
SECRET_KEY=change-me-generate-with-deploy-mailu

# Keep Mailu networking separate from the main LiveMask dev stack.
SUBNET=192.168.203.0/24

# TLS options depend on the host.
# - letsencrypt requires public 80/443 for Mailu front.
# - cert can mount existing certificate/key into /certs.
# - notls is only for private dry-runs.
TLS_FLAVOR=letsencrypt

# Mailu feature switches.
ADMIN=true
WEB_ADMIN=/admin
WEBMAIL=snappymail
WEB_WEBMAIL=/webmail
ANTIVIRUS=none
SCAN_MACROS=true
FETCHMAIL_ENABLED=false
MESSAGE_SIZE_LIMIT=50000000
PORTS=25,80,443,465,587,143,993,110,995,4190

# Persistence.
MAILU_DATA_DIR=/opt/livemask-mailu/data
MAILU_CERTS_DIR=/opt/livemask-mailu/certs

# Public ports. If the host already has nginx on 80/443, set WEB ports to
# unused local ports and terminate web UI through the existing nginx layer.
MAILU_SMTP_PORT=25
MAILU_SUBMISSION_PORT=587
MAILU_SUBMISSIONS_PORT=465
MAILU_IMAP_PORT=143
MAILU_IMAPS_PORT=993
MAILU_POP3_PORT=110
MAILU_POP3S_PORT=995
MAILU_SIEVE_PORT=4190
MAILU_HTTP_PORT=80
MAILU_HTTPS_PORT=443

# Default LiveMask mailboxes. Passwords are read from
# /opt/livemask-mailu/credentials.env by scripts/deploy-mailu.sh.
MAILU_ADMIN_LOCALPART=admin
MAILU_SUPPORT_LOCALPART=support
MAILU_NO_REPLY_LOCALPART=no-reply

# Outbound delivery.
# Direct MX delivery requires outbound TCP 25 from the host to recipient mail
# exchangers. Many cloud providers block it. When TCP 25 is blocked, configure
# an upstream SMTP relay over 587/465 instead of expecting Mailu to deliver
# directly.
#
# Example:
# RELAYHOST=[smtp-relay.example.com]:587
# RELAYUSER=no-reply@livemask-vpn.com
# RELAYPASSWORD=change-me-store-only-in-runtime-env

# Backend/Admin SMTP defaults after Mailu is live:
# host=smtp.livemask-vpn.com
# port=587
# tls_mode=starttls
# username=no-reply@livemask-vpn.com
# from_address=no-reply@livemask-vpn.com
# reply_to=support@livemask-vpn.com
