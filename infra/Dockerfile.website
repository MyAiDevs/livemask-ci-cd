# stage 1: build
FROM node:22-alpine AS builder

# Source is provisioned by scripts/prepare-staging-build-context.sh
# into infra/_build_deps/website/, which is in the build context.
COPY _build_deps/website/ /src/

RUN if [ ! -f /src/package.json ]; then \
      echo "FATAL: No package.json found in /src/." >&2; \
      echo "Run scripts/prepare-staging-build-context.sh before docker compose build." >&2; \
      exit 1; \
    fi

WORKDIR /src
ARG VITE_API_BASE_URL=http://127.0.0.1:18080
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm ci
RUN npm run build

# stage 2: runtime
FROM node:22-alpine
WORKDIR /app
COPY --from=builder /src/package*.json ./
RUN npm ci --include=dev --no-audit --no-fund
COPY --from=builder /src/dist ./dist
ENV NODE_ENV=production
RUN printf '%s\n' \
  'const splitHosts = (value) => (value || "").split(",").map((item) => item.trim()).filter(Boolean);' \
  'const primaryDomains = splitHosts(process.env.PUBLIC_PRIMARY_DOMAIN);' \
  'const allowedHosts = Array.from(new Set([' \
  '  "livemask-vpn.com",' \
  '  "www.livemask-vpn.com",' \
  '  "localhost",' \
  '  "127.0.0.1",' \
  '  ...primaryDomains,' \
  '  ...primaryDomains.map((domain) => "www." + domain),' \
  '  ...splitHosts(process.env.VITE_PREVIEW_ALLOWED_HOSTS),' \
  ']));' \
  'export default {' \
  '  preview: {' \
  '    host: "0.0.0.0",' \
  '    port: Number(process.env.VITE_PREVIEW_PORT || 3000),' \
  '    allowedHosts,' \
  '  },' \
  '};' \
  > /app/vite.preview.config.mjs
EXPOSE 3000
CMD ["npm", "run", "preview", "--", "--config", "/app/vite.preview.config.mjs", "--host", "0.0.0.0", "--port", "3000"]
