# LiveMask staging runtime.
# This can use internal PostgreSQL/Redis containers or external cloud services.
# Use either livemask-dev or livemask-staging on a host, not both.

LIVEMASK_STACK_NAME=livemask-staging

POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine

POSTGRES_USER=livemask
POSTGRES_PASSWORD=change-me
POSTGRES_DB=livemask
POSTGRES_PORT=15432
REDIS_PORT=16379

# Default app services reach dependencies through stable host ports so each
# service can be recreated independently without relying on compose DNS.
DB_DSN=postgres://livemask:change-me@host.docker.internal:15432/livemask?sslmode=disable
REDIS_ADDR=host.docker.internal:16379

# For cloud deps, set --no-deps or skip --start-deps and replace DB_DSN/REDIS_ADDR:
# DB_DSN=postgres://user:password@cloud-postgres.example.com:5432/livemask?sslmode=require
# REDIS_ADDR=cloud-redis.example.com:6379

BACKEND_IMAGE=ghcr.io/myaidevs/livemask-backend:dev
ADMIN_IMAGE=ghcr.io/myaidevs/livemask-admin:dev
WEBSITE_IMAGE=ghcr.io/myaidevs/livemask-website:dev
NODEAGENT_IMAGE=ghcr.io/myaidevs/livemask-nodeagent:dev
NODEAGENT_IMAGE_SOURCES=ghcr.io/myaidevs/livemask-nodeagent:dev docker.io/myaidevs/livemask-nodeagent:dev registry.cn-hongkong.aliyuncs.com/livemask/livemask-nodeagent:dev

LIVEMASK_WEBSITE_PORT=64000
LIVEMASK_ADMIN_PORT=64001
LIVEMASK_JOB_SERVICE_PORT=64002
LIVEMASK_BACKEND_HTTP_PORT=64003
LIVEMASK_BACKEND_NODEAGENT_TLS_PORT=64004
LIVEMASK_NODEAGENT_PORT=65000
LIVEMASK_NODEAGENT_SERVICE_PORT=65000
NODEAGENT_CONTROL_TOKEN=change-me-nodeagent-control-token
PUBLIC_PRIMARY_DOMAIN=livemask-vpn.com
VITE_PREVIEW_ALLOWED_HOSTS=livemask-vpn.com,www.livemask-vpn.com,47.243.128.122,localhost,127.0.0.1
SINGBOX_PUBLIC_ENDPOINT_PORT_START=65001
SINGBOX_PUBLIC_ENDPOINT_PORT_END=65535
SINGBOX_LISTEN_PORT_START=65001
SINGBOX_LISTEN_PORT_END=65535
BACKEND_VERSION=staging
INTERNAL_SERVICE_SECRET=change-me-internal-service-secret
JWT_SECRET=change-me-long-random-jwt-secret
NODEAGENT_BACKEND_BASE_URL=https://host.docker.internal:64004
BACKEND_SERVICE_AUTH_MODE=internal_secret
BACKEND_INTERNAL_SECRET=change-me-internal-service-secret

# Public API used by Website builds and Backend-rendered links in staging.
# Defaults to https://api.livemask-vpn.com so browser clients and sponsor
# NodeAgent install bundles do not point at localhost/internal container URLs.
# Override PUBLIC_API_BASE_URL for a staging-specific API domain; only use
# STAGING_PUBLIC_API_BASE_URL=http://127.0.0.1:64003 for private host-local QA.
# PUBLIC_API_BASE_URL=https://api.staging.example.com
# STAGING_PUBLIC_API_BASE_URL=http://127.0.0.1:64003

# Optional dev/staging test data is seeded explicitly with:
#   bash scripts/seed-dev-test-data.sh
