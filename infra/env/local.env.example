# LiveMask local Docker runtime.
# Copy to local.env and adjust only when ports or mirrors conflict.

LIVEMASK_STACK_NAME=livemask-local

POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
BACKEND_GO_IMAGE=golang:1.25-alpine
ADMIN_NODE_IMAGE=node:22-alpine
WEBSITE_NODE_IMAGE=node:22-alpine
APP_FLUTTER_IMAGE=ghcr.io/cirruslabs/flutter:stable
NODEAGENT_GO_IMAGE=golang:1.26-alpine

POSTGRES_USER=livemask
POSTGRES_PASSWORD=livemask
POSTGRES_DB=livemask
POSTGRES_PORT=15432
REDIS_PORT=16379

LIVEMASK_BACKEND_HTTP_PORT=18080
LIVEMASK_ADMIN_PORT=3001
LIVEMASK_WEBSITE_PORT=3002
LIVEMASK_APP_WEB_PORT=3003
LIVEMASK_NODEAGENT_PORT=19090
NODEAGENT_CONTROL_TOKEN=dev-nodeagent-control-token-change-me
# Sing-box listen bind for LAN device testing. Backend runtime_config controls
# the active business port; Compose only publishes the usable host/container range.
# Android VPN requires hysteria2 (UDP) end-to-end - mixed :10808 is HTTP/SOCKS only.
# One-shot align (Postgres + template + NodeAgent apply + verify):
#   bash livemask-ci-cd/scripts/align-android-hysteria2-local.sh
SINGBOX_LISTEN_HOST=0.0.0.0
SINGBOX_PUBLIC_ENDPOINT_PORT_START=65001
SINGBOX_PUBLIC_ENDPOINT_PORT_END=65535
SINGBOX_LISTEN_PORT_START=65001
SINGBOX_LISTEN_PORT_END=65535
SINGBOX_TRANSPORT=udp
SINGBOX_PROTOCOL_PROFILE=hysteria2
SINGBOX_PUBLIC_ENDPOINT_HOST=192.168.1.64
SINGBOX_CACHE_BIN=/workspace/.singbox-cache/sing-box
SINGBOX_RUNTIME_CACHE_BIN=/workspace/.state/sing-box
# HY2 TCP/UDP range is published on the host via docker-compose (65001-65535).
HYSTERIA2_AUTH=local-dev-hy2-auth

BACKEND_VERSION=dev-local
GOPROXY=https://goproxy.cn,direct
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Keep Admin node detail logs fresh in local dev. NodeAgent writes to Docker
# stdout regardless; this controls upload into Backend observability logs.
LOG_UPLOAD_ENABLED=true

# Dev-only test data is seeded explicitly with:
#   bash scripts/seed-dev-test-data.sh
